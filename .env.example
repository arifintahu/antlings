# Antlings settings. Copy to .env for local use, or let deploy/install.sh create /etc/antlings/antlings.env.
# Generate the secrets with: node server/dist/cli.js gen-env   (prints ANTLINGS_SECRET_KEY and the VAPID pair)
ANTLINGS_ORIGIN=http://localhost:3100
ANTLINGS_HOST=127.0.0.1
ANTLINGS_PORT=3100
ANTLINGS_DATA_DIR=./data
# Built web app. Run `pnpm build` first, then open the ORIGIN above.
ANTLINGS_STATIC_DIR=../web/dist
# Root of the folder picker. Defaults to the home folder of the user running the service.
# ANTLINGS_HOME=/home/antlings
# Path of the installed claude binary. Defaults to the one bundled with the SDK.
# ANTLINGS_CLAUDE_PATH=/usr/bin/claude
ANTLINGS_AUTH_MODE=apikey
# ANTHROPIC_API_KEY=
ANTLINGS_MAX_SESSIONS=2
ANTLINGS_MAX_SUBAGENTS=3
ANTLINGS_IDLE_HOURS=12
# 32 random bytes, base64. Required.
ANTLINGS_SECRET_KEY=
# Optional, for push notifications.
ANTLINGS_VAPID_PUBLIC=
ANTLINGS_VAPID_PRIVATE=
ANTLINGS_VAPID_SUBJECT=mailto:owner@localhost
