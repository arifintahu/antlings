{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["svelte", "vite/client", "node"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "allowJs": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "scripts/**/*.ts",
    "vite.config.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
