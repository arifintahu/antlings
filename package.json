{
  "name": "antlings",
  "private": true,
  "description": "A self-hosted web UI for Claude Code, with a lead ant per session and a worker ant per subagent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arifintahu/antlings.git"
  },
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm -r build",
    "e2e": "pnpm --filter @antlings/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
